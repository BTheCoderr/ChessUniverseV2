{
  "name": "chess-universe",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first Black-first chess PWA using browser JSON persistence for offline play and Supabase only for trusted online competition.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-pwa.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "mobile:sync": "npm run build:native && npx cap sync",
    "mobile:init:ios": "npx cap add ios --packagemanager SPM",
    "mobile:init:android": "npx cap add android",
    "mobile:assets": "npx @capacitor/assets generate --iconBackgroundColor '#d7ff4a' --iconBackgroundColorDark '#101314' --splashBackgroundColor '#0b0e0f' --splashBackgroundColorDark '#0b0e0f'",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "mobile:configure": "node scripts/configure-native-projects.mjs",
    "build:native": "tsc -b && vite build --mode native"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "chess.js": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "keywords": [
    "chess",
    "react",
    "typescript",
    "supabase",
    "vite",
    "pwa",
    "multiplayer",
    "stockfish",
    "battle-chess",
    "local-first",
    "localstorage",
    "offline-first"
  ]
}
