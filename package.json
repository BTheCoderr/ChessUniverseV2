{
  "name": "chess-universe",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first Black-first chess PWA with trusted multiplayer, Battle Chess, Seasons, Championships, progression, and rivalries.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-pwa.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "chess.js": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "keywords": [
    "chess",
    "react",
    "typescript",
    "supabase",
    "vite",
    "pwa",
    "multiplayer",
    "stockfish",
    "battle-chess"
  ]
}
